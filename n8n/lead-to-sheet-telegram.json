{
  "name": "Lead → Google Sheets → Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "lead",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Webhook secret (X-Webhook-Secret)" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "Дата", "type": "string", "value": "={{ $now.setZone('Asia/Almaty').toFormat('yyyy-MM-dd HH:mm') }}" },
            { "id": "f2", "name": "Имя", "type": "string", "value": "={{ $json.body.name || $json.body.Name || '' }}" },
            { "id": "f3", "name": "Телефон", "type": "string", "value": "={{ (() => { const d = String($json.body.phone || $json.body.Phone || '').replace(/\\D/g, ''); if (d.length === 11 && /^[78]/.test(d)) return '+7' + d.slice(1); if (d.length === 10) return '+7' + d; return d ? '+' + d : ''; })() }}" },
            { "id": "f4", "name": "Источник", "type": "string", "value": "={{ $json.body.source || 'website' }}" },
            { "id": "f5", "name": "Комментарий", "type": "string", "value": "={{ $json.body.comment || $json.body.Comments || '' }}" },
            { "id": "f6", "name": "Статус", "type": "string", "value": "Новая" },
            { "id": "f7", "name": "Ответственный", "type": "string", "value": "" },
            { "id": "f8", "name": "Email", "type": "string", "value": "={{ $json.body.email || $json.body.Email || '' }}" },
            { "id": "f9", "name": "UTM", "type": "string", "value": "={{ $json.body.utm_source ? 'utm_source=' + $json.body.utm_source : '' }}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "YOUR_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": { "mappingMode": "autoMapInputData", "value": {} },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 0],
      "credentials": {
        "googleApi": { "id": "", "name": "Google service account" }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "=🔔 New lead · {{ $('Normalize lead').item.json['Источник'] }}\n👤 {{ $('Normalize lead').item.json['Имя'] }}\n📞 {{ $('Normalize lead').item.json['Телефон'] }}\n💬 {{ $('Normalize lead').item.json['Комментарий'] }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 0],
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram bot" }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Normalize lead", "type": "main", "index": 0 }]] },
    "Normalize lead": { "main": [[{ "node": "Google Sheets", "type": "main", "index": 0 }]] },
    "Google Sheets": { "main": [[{ "node": "Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Almaty" },
  "pinData": {}
}
