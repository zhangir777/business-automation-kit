        },
        "options": { "cellFormat": "RAW" }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [880, 0],
      "credentials": {
        "googleApi": { "id": "", "name": "Google service account" }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "=🔔 New lead · {{ $('Normalize lead').item.json['Источник'] }}\n{{ ({ hot: '🔥', warm: '🙂', cold: '❄️' })[$('Parse AI').item.json.category] || '❔' }} {{ $('Parse AI').item.json.category }} ({{ $('Parse AI').item.json.score }}/10)\n👤 {{ $('Normalize lead').item.json['Имя'] }}\n📞 {{ $('Normalize lead').item.json['Телефон'] }}\n💬 {{ $('Normalize lead').item.json['Комментарий'] }}",
        "additionalFields": { "appendAttribution": false }
