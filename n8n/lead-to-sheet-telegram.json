            "score": "={{ $json.score }}",
            "category": "={{ $json.category }}",
            "reply": "={{ $json.reply }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "Дата", "displayName": "Дата", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
