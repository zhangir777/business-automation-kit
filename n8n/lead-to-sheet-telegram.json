{
  "name": "Lead → Google Sheets → Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "lead",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Webhook secret (X-Webhook-Secret)" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "Дата", "type": "string", "value": "={{ $now.setZone('Asia/Almaty').toFormat('yyyy-MM-dd HH:mm') }}" },
            { "id": "f2", "name": "Имя", "type": "string", "value": "={{ $json.body.name || $json.body.Name || '' }}" },
            { "id": "f3", "name": "Телефон", "type": "string", "value": "={{ (() => { const d = String($json.body.phone || $json.body.Phone || '').replace(/\\D/g, ''); if (d.length === 11 && /^[78]/.test(d)) return '+7' + d.slice(1); if (d.length === 10) return '+7' + d; return d ? '+' + d : ''; })() }}" },
            { "id": "f4", "name": "Источник", "type": "string", "value": "={{ $json.body.source || 'website' }}" },
            { "id": "f5", "name": "Комментарий", "type": "string", "value": "={{ $json.body.comment || $json.body.Comments || '' }}" },
            { "id": "f6", "name": "Статус", "type": "string", "value": "Новая" },
            { "id": "f7", "name": "Ответственный", "type": "string", "value": "" },
            { "id": "f8", "name": "Email", "type": "string", "value": "={{ $json.body.email || $json.body.Email || '' }}" },
            { "id": "f9", "name": "UTM", "type": "string", "value": "={{ $json.body.utm_source ? 'utm_source=' + $json.body.utm_source : '' }}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{$env.GEMINI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Qualify this incoming sales lead and return a JSON object with keys: \"score\" (integer 1-10), \"category\" (\"hot\", \"warm\", or \"cold\"), and \"reply\" (a short polite first reply to the client in the client\\'s language, defaulting to Russian if unclear). Lead: ' + JSON.stringify({ name: $json['Имя'] || $json.name || '', phone: $json['Телефон'] || $json.phone || '', source: $json['Источник'] || $json.source || '', comment: $json['Комментарий'] || $json.comment || '' }) }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "options": {}
      },
      "id": "b5e7c9a1-3f42-4d8e-9a1b-6c2d8e4f1a05",
      "name": "AI qualify lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "Дата", "type": "string", "value": "={{ $('Normalize lead').item.json['Дата'] }}" },
            { "id": "p2", "name": "Имя", "type": "string", "value": "={{ $('Normalize lead').item.json['Имя'] }}" },
            { "id": "p3", "name": "Телефон", "type": "string", "value": "={{ $('Normalize lead').item.json['Телефон'] }}" },
            { "id": "p4", "name": "Источник", "type": "string", "value": "={{ $('Normalize lead').item.json['Источник'] }}" },
            { "id": "p5", "name": "Комментарий", "type": "string", "value": "={{ $('Normalize lead').item.json['Комментарий'] }}" },
            { "id": "p6", "name": "Статус", "type": "string", "value": "={{ $('Normalize lead').item.json['Статус'] }}" },
            { "id": "p7", "name": "Ответственный", "type": "string", "value": "={{ $('Normalize lead').item.json['Ответственный'] }}" },
            { "id": "p8", "name": "Email", "type": "string", "value": "={{ $('Normalize lead').item.json['Email'] }}" },
            { "id": "p9", "name": "UTM", "type": "string", "value": "={{ $('Normalize lead').item.json['UTM'] }}" },
            { "id": "p10", "name": "score", "type": "number", "value": "={{ (() => { try { const raw = String($json.candidates[0].content.parts[0].text).replace(/^```(?:json)?\\s*|\\s*```$/gi, ''); const p = JSON.parse(raw); const o = Array.isArray(p) ? p[0] : p; const n = Number(o.score); return Number.isFinite(n) && n >= 1 && n <= 10 ? Math.round(n) : 0; } catch (e) { return 0; } })() }}" },
            { "id": "p11", "name": "category", "type": "string", "value": "={{ (() => { try { const raw = String($json.candidates[0].content.parts[0].text).replace(/^```(?:json)?\\s*|\\s*```$/gi, ''); const p = JSON.parse(raw); const o = Array.isArray(p) ? p[0] : p; const c = String(o.category || '').trim().toLowerCase(); return ['hot', 'warm', 'cold'].includes(c) ? c : 'unknown'; } catch (e) { return 'unknown'; } })() }}" },
            { "id": "p12", "name": "reply", "type": "string", "value": "={{ (() => { try { const raw = String($json.candidates[0].content.parts[0].text).replace(/^```(?:json)?\\s*|\\s*```$/gi, ''); const p = JSON.parse(raw); const o = Array.isArray(p) ? p[0] : p; return typeof o.reply === 'string' ? o.reply.trim() : ''; } catch (e) { return ''; } })() }}" }
          ]
        },
        "options": {}
      },
      "id": "c8d4f2e6-7a19-4b3c-8e5d-2f9a1c7b3e06",
      "name": "Parse AI",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "YOUR_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Дата": "={{ $json['Дата'] }}",
            "Имя": "={{ $json['Имя'] }}",
