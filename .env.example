# Leave Google/Telegram empty for demo mode (data/leads.xlsx + log). Never commit .env
WEBHOOK_SECRET=change-me-to-a-long-random-string
TIMEZONE=Asia/Almaty

# Google Sheets (docs/GOOGLE_SETUP.md). Key file goes to secrets/ (git-ignored)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json
GOOGLE_WORKSHEET=Leads
# Sheet header and status labels: ru or en
SHEET_LANGUAGE=ru

# Telegram: bot token from @BotFather, chat ids as JSON list, e.g. [123456789]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=[]

# Weekly report by email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

STALE_HOURS=2
DAILY_SUMMARY_TIME=19:00
